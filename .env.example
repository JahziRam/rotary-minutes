# Database — Neon (https://console.neon.tech) recommended for Vercel
# Runtime (Next.js / Prisma Client): use the *pooled* connection string (-pooler host)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Prisma CLI (migrate, studio): use the *direct* connection string (no -pooler)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# See scripts/deploy-vercel-neon.md for full Render → Vercel + Neon migration.

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Uploads
# Profile photos & club logos: enabled by default (server-side resize ≤ ~120 KB JPEG).
# Set IMAGE_UPLOADS_ENABLED=false to suspend image uploads only.
# IMAGE_UPLOADS_ENABLED="true"
# Documents / attachments: enabled by default (max 5 files × 5 MB; PDF/Office/TXT only).
# Set UPLOADS_ENABLED=false or DOCUMENT_UPLOADS_ENABLED=false to suspend.
# UPLOADS_ENABLED="true"
# DOCUMENT_UPLOADS_ENABLED="true"
# Vercel Blob (recommended in production): store photos/docs outside Postgres.
# Create a Blob store in Vercel dashboard and paste the read-write token.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# App
# Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production:
# NEXT_PUBLIC_APP_URL="https://clubminutes.api.mg"
# NEXTAUTH_URL="https://clubminutes.api.mg"
NEXT_PUBLIC_APP_NAME="Rotary Minutes"

# Google Analytics 4 — peut aussi être configuré dans Admin → Paramètres
# Créer un flux Web sur https://clubminutes.api.mg dans analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-BLS005G55Y"
# Set to "true" to enable GA in local dev (disabled by default outside production)
# NEXT_PUBLIC_GA_ENABLED="true"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@rotaryminutes.app"

# Assistant IA rédaction PV (module MINUTE_AI) — fournisseur par défaut : SpaceXAI (xAI)
XAI_API_KEY="xai-..."
# XAI_MINUTE_AI_MODEL="grok-3-mini"

# Alternative Qwen (DashScope) — Admin → Paramètres → Fournisseur IA : Qwen
# DASHSCOPE_API_KEY="sk-..."
# QWEN_MINUTE_AI_MODEL="qwen-plus"
# QWEN_API_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# Alternative OpenAI — Admin → Paramètres → Fournisseur IA : OpenAI
# OPENAI_API_KEY="sk-..."
# OPENAI_MINUTE_AI_MODEL="gpt-4o-mini"
# OPENAI_API_BASE_URL="https://api.openai.com/v1"

# Cron jobs (trial expiry, email campaigns)
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Referral program — free days granted to referrer when referred club subscribes
REFERRAL_REWARD_DAYS=30

# Android app (Capacitor) — npm run android:sync / android:open
# Production (app charge le site hébergé) :
CAPACITOR_SERVER_URL="https://clubminutes.api.mg/fr/dashboard"
# Émulateur Android + serveur local :
# CAPACITOR_SERVER_URL="http://10.0.2.2:3000/fr/dashboard"
CAPACITOR_APP_NAME="Rotary Minutes"

# Super Admin (created via: npm run db:seed)
# Email: superadmin@rotaryminutes.app
# Password: RotaryAdmin2026!